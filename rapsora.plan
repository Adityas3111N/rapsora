━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  7. QUALITY CHECKLIST (Before Considering Homepage "Done")
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  DESIGN
  [ ] Every section has clear visual hierarchy
  [ ] Consistent spacing rhythm across all sections
  [ ] Typography scale is harmonious (not random font sizes)
  [ ] Color usage is intentional (purple = action, not decoration)
  [ ] Dark mode looks as good as light mode
  [ ] Design feels premium, not template-ish

  ANIMATION
  [ ] All animations serve a purpose (guide attention, not distract)
  [ ] Animations are smooth (60fps, no jank)
  [ ] Reduced motion is respected (prefers-reduced-motion)
  [ ] No "animation overload" — subtle > flashy

  RESPONSIVENESS
  [ ] Tested at: 320px, 375px, 768px, 1024px, 1440px, 1920px
  [ ] Touch targets are ≥44px on mobile
  [ ] Text is readable without zooming on mobile
  [ ] No horizontal scroll at any breakpoint

  PERFORMANCE
  [ ] Lighthouse 95+ on all categories
  [ ] All images use next/image with proper sizing
  [ ] No layout shift (CLS < 0.1)
  [ ] Fonts are preloaded / display: swap

  SEO
  [ ] Unique, compelling title and meta description
  [ ] Single <h1> on the page
  [ ] Proper heading hierarchy (h1 → h2 → h3)
  [ ] All images have descriptive alt text
  [ ] Open Graph + Twitter Card meta present

  ACCESSIBILITY
  [ ] All interactive elements are keyboard-focusable
  [ ] Focus indicators are visible
  [ ] Color contrast passes WCAG AA
  [ ] Screen reader tested (sensible reading order)

  CONVERSION
  [ ] Primary CTA ("Start a Project") visible without scrolling
  [ ] CTA appears at least 3 times on the page (header, hero, footer banner)
  [ ] Phone/email contact info available
  [ ] No dead-end sections (every section links somewhere)
  [ ] Page tells a complete story top-to-bottom


━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  READY TO BUILD
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

