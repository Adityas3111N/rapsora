━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  4. TECHNICAL IMPLEMENTATION PLAN
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  Tech Stack:
  ├── Framework:      Next.js 16 (App Router, RSC)
  ├── Language:       TypeScript (strict mode)
  ├── Styling:        Tailwind CSS v4 + custom CSS variables
  ├── Components:     shadcn/ui (Radix primitives)
  ├── Animations:     Framer Motion
  ├── Icons:          Lucide React
  ├── Fonts:          Satoshi (headings) + Inter (body)
  ├── Code Quality:   ESLint + Prettier
  └── Deployment:     Vercel (recommended)

  Performance Targets:
  ├── Lighthouse Score:    95+ across all categories
  ├── First Contentful Paint:  < 1.5s
  ├── Largest Contentful Paint: < 2.5s
  ├── Cumulative Layout Shift:  < 0.1
  └── Total Bundle Size:  < 200KB (gzipped, first load)

  SEO Strategy:
  ├── generateMetadata() on every page
  ├── Structured data (JSON-LD) for Organization + WebSite
  ├── Open Graph + Twitter card meta for all pages
  ├── Sitemap.xml (auto-generated)
  ├── Robots.txt
  ├── Semantic HTML throughout
  └── Image optimization (next/image, WebP, lazy loading)


━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  5. DEVELOPMENT PHASES & ORDER OF EXECUTION
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  We will build in this exact order, validating each step:

  ┌──────────────────────────────────────────────────────────────────┐
  │  PHASE 1: DATA & TYPES                               ~1 hour   │
  │  ├── src/types/index.ts (all interfaces)                        │
  │  ├── src/constants/site.ts (site metadata)                      │
  │  ├── src/constants/navigation.ts (nav structure)                │
  │  └── src/content/*.ts (projects, services, testimonials)        │
  │                                                                  │
  │  PHASE 2: LAYOUT SHELL                               ~3 hours  │
  │  ├── src/components/layout/header.tsx (sticky nav + mega-menu)  │
  │  ├── src/components/layout/footer.tsx (full footer)             │
  │  ├── src/components/layout/site-layout.tsx (wrapper)            │
  │  ├── src/hooks/useTheme.ts (dark mode)                          │
  │  └── src/hooks/useScrollPosition.ts                             │
  │                                                                  │
  │  PHASE 3: HERO SECTION                               ~3 hours  │
  │  ├── src/components/sections/hero.tsx                            │
  │  ├── Animated text component                                     │
  │  ├── Abstract visual / gradient blob                             │
  │  └── Perfect responsiveness across all breakpoints               │
  │                                                                  │
  │  PHASE 4: REMAINING HOMEPAGE SECTIONS                ~8 hours  │
  │  ├── src/components/sections/logo-marquee.tsx                    │
  │  ├── src/components/sections/featured-work.tsx                   │
  │  ├── src/components/sections/services-overview.tsx               │
  │  ├── src/components/sections/why-rapsora.tsx                     │
  │  ├── src/components/sections/testimonials.tsx                    │
  │  ├── src/components/sections/process.tsx                         │
  │  ├── src/components/sections/blog-preview.tsx                    │
  │  └── src/components/sections/cta-banner.tsx                      │
  │                                                                  │
  │  PHASE 5: HOMEPAGE ASSEMBLY & POLISH                 ~2 hours  │
  │  ├── app/page.tsx (compose all sections)                         │
  │  ├── Scroll animation orchestration                              │
  │  ├── Responsive testing (mobile, tablet, desktop)                │
  │  ├── Performance optimization                                    │
  │  └── SEO meta (generateMetadata, JSON-LD)                       │
  │                                                                  │
  │  ── HOMEPAGE COMPLETE ──                                         │
  │                                                                  │
  │  PHASE 6+: INTERIOR PAGES (future)                              │
  │  ├── /work (portfolio grid)                                      │
  │  ├── /work/[slug] (case study)                                   │
  │  ├── /services (detailed services)                               │
  │  ├── /about (team, culture, stats)                               │
  │  ├── /blog (blog listing)                                        │
  │  ├── /blog/[slug] (blog post)                                    │
  │  └── /contact (form + info)                                      │
  └──────────────────────────────────────────────────────────────────┘


